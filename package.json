{
  "name": "shadow-box-backend",
  "version": "0.0.1",
  "description": "ShadowBox mail service API",
  "author": "",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "nest start --watch --entryFile worker",
    "start:worker:prod": "node dist/worker",
    "start:delivery": "nest start --watch --entryFile delivery",
    "start:delivery:prod": "node dist/delivery",
    "lint": "oxlint -c oxlint.json --type-aware --deny-warnings src/ test/ scripts/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "postinstall": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "mail:inject": "node scripts/mail-inject.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "helmet": "^8.3.0",
    "mailauth": "^7.1.1",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "postal-mime": "^4.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "smtp-server": "^3.19.17",
    "sodium-native": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "dotenv": "^18.0.5",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "mysql2": "^3.24.5",
    "deepmerge-ts": "^8.0.2"
  }
}
