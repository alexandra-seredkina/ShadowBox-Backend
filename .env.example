POSTGRES_DB=shadowbox
POSTGRES_USER=shadowbox
POSTGRES_PASSWORD=change-me

# Host ports, bound to 127.0.0.1 only
DB_HOST_PORT=5433
HTTP_PORT=8080
LMTP_HOST_PORT=2424
SMTP_HOST_PORT=2525

# For Prisma and tests run from the host
DATABASE_URL=postgresql://shadowbox:change-me@localhost:5433/shadowbox?schema=public

# Origins allowed to send mutating requests (comma-separated)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Key for decoy salts of /auth/prelogin, base64url of 32 random bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never change it once running: a new key would reveal which logins do not exist.
PRELOGIN_SALT_KEY=

# Mail domain of issued addresses (shadowbox.test until a real domain exists)
MAIL_DOMAIN=shadowbox.test

# HMAC key for client IPs, base64url of 32 random bytes (generate like PRELOGIN_SALT_KEY).
# Rotate monthly: move the old key to IP_HASH_PREVIOUS_KEY, set a new key and
# raise IP_HASH_KEY_VERSION. Drop the previous key after 30 days, when every
# session hashed with it has expired.
IP_HASH_KEY=
IP_HASH_KEY_VERSION=1
IP_HASH_PREVIOUS_KEY=

# HMAC key for senders an account has had mail from, base64url of 32 random
# bytes (generate like PRELOGIN_SALT_KEY). A new key makes every sender look
# new once, so raise SENDER_HASH_KEY_VERSION with it.
SENDER_HASH_KEY=
SENDER_HASH_KEY_VERSION=1

# Sign-ups per hour per IP; 0 turns the limit off for local testing only
REGISTER_RATE_LIMIT_PER_HOUR=3
