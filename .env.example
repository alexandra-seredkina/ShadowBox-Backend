POSTGRES_DB=shadowbox
POSTGRES_USER=shadowbox
POSTGRES_PASSWORD=change-me

# Порты на хосте, слушают только 127.0.0.1
DB_HOST_PORT=5433
HTTP_PORT=8080

# Для prisma и тестов, запущенных с хоста
DATABASE_URL=postgresql://shadowbox:change-me@localhost:5433/shadowbox?schema=public

# Откуда принимаются изменяющие запросы (через запятую)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Ключ для фиктивных солей /auth/prelogin, base64url от 32 случайных байт.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Не менять после запуска: смена ключа выдаст, какие логины не существуют.
PRELOGIN_SALT_KEY=

# Mail domain of issued addresses (D-023: shadowbox.test until a real domain exists)
MAIL_DOMAIN=shadowbox.test

# HMAC key for client IPs, base64url of 32 random bytes (generate like PRELOGIN_SALT_KEY).
# Rotate by setting a new key and raising IP_HASH_KEY_VERSION.
IP_HASH_KEY=
IP_HASH_KEY_VERSION=1
