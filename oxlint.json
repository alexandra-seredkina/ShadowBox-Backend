{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/ban-ts-comment": "error",
    "no-console": "error",
    "no-unused-vars": "error",
    "eqeqeq": "error",
    "no-param-reassign": "error",
    "max-depth": ["error", 3],
    "complexity": ["error", 10],
    "import/no-default-export": "error"
  },
  "env": {
    "node": true
  },
  "ignorePatterns": ["src/generated/**", "dist/**"],
  "overrides": [
    {
      "files": ["src/modules/*/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@nestjs/*",
                  "@prisma/*",
                  "express",
                  "node:fs",
                  "node:fs/*",
                  "**/generated/**",
                  "**/application/**",
                  "**/infrastructure/**",
                  "**/presentation/**"
                ],
                "message": "domain/ is plain TypeScript: no framework, ORM or outer layers"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/modules/*/application/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@prisma/*",
                  "express",
                  "**/generated/**",
                  "**/infrastructure/**",
                  "**/presentation/**"
                ],
                "message": "application/ depends on ports declared in domain/, not on adapters"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/modules/*/presentation/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@prisma/*",
                  "**/generated/**",
                  "**/infrastructure/**"
                ],
                "message": "presentation/ calls use cases, it never touches persistence"
              }
            ]
          }
        ]
      }
    }
  ]
}
